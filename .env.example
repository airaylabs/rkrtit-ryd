# RayCorp Recruitment System - Environment Configuration
# Copy this file to .env and update the values

# Database Configuration
DB_HOST=localhost
DB_NAME=recruitment
DB_USER=root
DB_PASS=

# Admin Password (generate hash with: php -r "echo password_hash('your_password', PASSWORD_DEFAULT);")
ADMIN_PASSWORD_HASH=

# n8n Webhook URL (optional - for notifications)
N8N_WEBHOOK_URL=

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=https://recruitment.rayandra.com
