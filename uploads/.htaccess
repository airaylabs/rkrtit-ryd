# Deny all access to uploads directory
Order allow,deny
Deny from all

# Disable PHP execution
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Disable PHP execution (alternative method)
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

# Disable PHP execution (PHP 8)
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Block PHP files from being executed via handler
<FilesMatch "\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block common script extensions
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|pl|py|cgi|asp|aspx|jsp|sh|bash)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent directory listing
Options -Indexes -ExecCGI

# Remove handlers for PHP files
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
